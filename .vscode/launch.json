        ],
    "preRestartCommands": [
            // "file ./bootloader.elf",
            // "load",
            // "add-symbol-file ./build/release/release.elf 0x08002030",
            // "enable breakpoint",
            "monitor reset",
          ],
},
{
    "name": "Flash & Debug BootloaderUnderDev",
    "cwd": "${workspaceFolder:BootloaderUnderDev}",
    "executable": "${config:app_boot.build_dir}/zephyr/zephyr.elf",
    "request": "launch",
    "type": "cortex-debug",
    "servertype": "openocd",
    "interface": "swd",
    "device": "${config:bsp.soc}",
    "targetId": "${config:bsp.board}",
    "boardId": "1",
    "toolchainPrefix": "arm-zephyr-eabi",
